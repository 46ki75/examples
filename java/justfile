# Java task runner. Drives the Gradle build under java/aws
# (subproject: lambda-java).
set working-directory := 'aws'

default:
    @just --justfile {{justfile()}} --list

build:
    ./gradlew build

test:
    ./gradlew test

# `check` runs the test + verification tasks across every subproject.
ci:
    ./gradlew check
