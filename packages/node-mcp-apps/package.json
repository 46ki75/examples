{
  "name": "node-mcp-apps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal MCP Apps example: a React UI backed by an in-memory to-do list",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "serve": "tsx server.ts",
    "serve:stdio": "tsx server.ts --stdio",
    "start": "pnpm build && pnpm serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
