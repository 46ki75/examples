{
  "name": "node-mcp-apps-wordle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Apps Wordle: a shared game playable by both humans (UI) and agents (tools)",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "serve": "tsx server.ts",
    "serve:stdio": "tsx server.ts --stdio",
    "start": "pnpm build && pnpm serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "consola": "^3.4.2",
    "hono": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
