{
  "name": "node-mcp-apps-wordle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP Apps Wordle: a shared game playable by both humans (UI) and agents (tools)",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "serve": "tsx server.ts",
    "serve:stdio": "tsx server.ts --stdio",
    "start": "pnpm build && pnpm serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "consola": "^3.4.2",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
